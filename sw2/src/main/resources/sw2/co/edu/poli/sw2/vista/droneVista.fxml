<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0"
            prefWidth="793.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.poli.sw2.controller.DroneController">

    <children>

        <!-- TÍTULO -->
        <Label layoutX="310.0"
               layoutY="34.0"
               text="Gestión de Drones">

            <font>
                <Font size="24.0"/>
            </font>

        </Label>


        <!-- ID -->
        <Label layoutX="40.0"
               layoutY="89.0"
               text="ID:">

            <font>
                <Font size="18.0"/>
            </font>

        </Label>

        <TextField fx:id="txtId"
                   layoutX="140.0"
                   layoutY="89.0"
                   prefHeight="27.0"
                   prefWidth="564.0"/>


        <!-- SERIAL -->
        <Label layoutX="40.0"
               layoutY="142.0"
               text="Serial:">

            <font>
                <Font size="18.0"/>
            </font>

        </Label>

        <TextField fx:id="txtSerial"
                   layoutX="140.0"
                   layoutY="142.0"
                   prefHeight="27.0"
                   prefWidth="564.0"/>


        <!-- MODELO -->
        <Label layoutX="40.0"
               layoutY="201.0"
               text="Modelo:">

            <font>
                <Font size="18.0"/>
            </font>

        </Label>

        <TextField fx:id="txtModelo"
                   layoutX="140.0"
                   layoutY="201.0"
                   prefHeight="27.0"
                   prefWidth="564.0"/>


        <!-- FABRICANTE -->
        <Label layoutX="37.0"
               layoutY="260.0"
               text="Fabricante:">

            <font>
                <Font size="18.0"/>
            </font>

        </Label>

        <TextField fx:id="txtFabricante"
                   layoutX="140.0"
                   layoutY="260.0"
                   prefHeight="28.0"
                   prefWidth="564.0"/>


        <!-- PESO -->
        <Label layoutX="39.0"
               layoutY="319.0"
               text="Peso:">

            <font>
                <Font size="18.0"/>
            </font>

        </Label>

        <TextField fx:id="txtPeso"
                   layoutX="138.0"
                   layoutY="319.0"
                   prefHeight="28.0"
                   prefWidth="564.0"/>


        <!-- BOTONES -->

        <Button layoutX="36.0"
                layoutY="364.0"
                onAction="#guardarDrone"
                text="Guardar"
                prefWidth="100.0"/>

        <Button layoutX="347.0"
                layoutY="364.0"
                onAction="#modificarDrone"
                text="Modificar"
                prefWidth="100.0"/>

        <Button layoutX="657.0"
                layoutY="364.0"
                onAction="#eliminarDrone"
                text="Eliminar"
                prefWidth="100.0"/>


        <!-- TABLA -->

        <TableView fx:id="tblDrones"
                   layoutX="3.0"
                   layoutY="410.0"
                   prefHeight="180.0"
                   prefWidth="785.0">

            <columns>

                <!-- ID -->
                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="80.0"/>

                <!-- SERIAL -->
                <TableColumn fx:id="colSerial"
                             text="Serial"
                             prefWidth="150.0"/>

                <!-- MODELO -->
                <TableColumn fx:id="colModelo"
                             text="Modelo"
                             prefWidth="170.0"/>

                <!-- FABRICANTE -->
                <TableColumn fx:id="colFabricante"
                             text="Fabricante"
                             prefWidth="190.0"/>

                <!-- PESO -->
                <TableColumn fx:id="colPeso"
                             text="Peso"
                             prefWidth="100.0"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>