<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            prefHeight="700.0"
            prefWidth="800.0"
            styleClass="root-scroll"
            stylesheets="@droneVista.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.poli.sw2.controller.DroneController">

    <content>

        <AnchorPane prefHeight="960.0"
                    prefWidth="800.0"
                    styleClass="root-pane">

            <children>

                <!-- TÍTULO -->
                <Label layoutX="270.0"
                       layoutY="20.0"
                       styleClass="app-title"
                       text="Gestión de Drones">

                    <font>
                        <Font size="26.0"/>
                    </font>

                </Label>


                <!-- ===== TARJETA DEL FORMULARIO ===== -->
                <AnchorPane layoutX="15.0"
                            layoutY="70.0"
                            prefHeight="290.0"
                            prefWidth="770.0"
                            styleClass="card-panel">

                    <children>

                        <!-- ID -->
                        <Label layoutX="20.0"
                               layoutY="22.0"
                               styleClass="form-label"
                               text="ID:">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="txtId"
                                   layoutX="120.0"
                                   layoutY="18.0"
                                   prefHeight="30.0"
                                   prefWidth="620.0"
                                   styleClass="text-field-custom"/>


                        <!-- SERIAL -->
                        <Label layoutX="20.0"
                               layoutY="67.0"
                               styleClass="form-label"
                               text="Serial:">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="txtSerial"
                                   layoutX="120.0"
                                   layoutY="63.0"
                                   prefHeight="30.0"
                                   prefWidth="620.0"
                                   styleClass="text-field-custom"/>


                        <!-- MODELO -->
                        <Label layoutX="20.0"
                               layoutY="112.0"
                               styleClass="form-label"
                               text="Modelo:">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="txtModelo"
                                   layoutX="120.0"
                                   layoutY="108.0"
                                   prefHeight="30.0"
                                   prefWidth="620.0"
                                   styleClass="text-field-custom"/>


                        <!-- FABRICANTE -->
                        <Label layoutX="20.0"
                               layoutY="157.0"
                               styleClass="form-label"
                               text="Fabricante:">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="txtFabricante"
                                   layoutX="120.0"
                                   layoutY="153.0"
                                   prefHeight="30.0"
                                   prefWidth="620.0"
                                   styleClass="text-field-custom"/>


                        <!-- PESO -->
                        <Label layoutX="20.0"
                               layoutY="202.0"
                               styleClass="form-label"
                               text="Peso (kg):">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="txtPeso"
                                   layoutX="120.0"
                                   layoutY="198.0"
                                   prefHeight="30.0"
                                   prefWidth="200.0"
                                   styleClass="text-field-custom"/>


                        <!-- TIPO -->
                        <Label layoutX="360.0"
                               layoutY="202.0"
                               styleClass="form-label"
                               text="Tipo:">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Label>

                        <ComboBox fx:id="cbTipo"
                                  layoutX="420.0"
                                  layoutY="198.0"
                                  prefHeight="30.0"
                                  prefWidth="320.0"
                                  promptText="Seleccione el tipo de drone"
                                  styleClass="combo-custom"/>


                        <!-- SEPARADOR VISUAL: DATOS ESPECÍFICOS -->
                        <Label layoutX="20.0"
                               layoutY="240.0"
                               styleClass="section-title"
                               text="Datos específicos según el tipo"/>

                        <!-- CAPACIDAD TANQUE (AGRICULTURA) -->
                        <Label layoutX="20.0"
                               layoutY="264.0"
                               styleClass="form-label"
                               text="Capacidad tanque (Agricultura):">
                            <font>
                                <Font size="13.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="txtCapacidadTanque"
                                   layoutX="270.0"
                                   layoutY="260.0"
                                   prefHeight="28.0"
                                   prefWidth="140.0"
                                   styleClass="text-field-custom"/>

                        <!-- DETECCIÓN TÉRMICA (VIGILANCIA) -->
                        <CheckBox fx:id="chkDeteccionTermica"
                                  layoutX="450.0"
                                  layoutY="264.0"
                                  styleClass="check-custom"
                                  text="Detección térmica (Vigilancia)"/>

                    </children>

                </AnchorPane>


                <!-- ===== BOTONES ===== -->

                <Button layoutX="15.0"
                        layoutY="378.0"
                        onAction="#guardarDrone"
                        prefHeight="34.0"
                        prefWidth="130.0"
                        styleClass="button-save"
                        text="Guardar"/>

                <Button layoutX="175.0"
                        layoutY="378.0"
                        onAction="#construirConBuilder"
                        prefHeight="34.0"
                        prefWidth="130.0"
                        styleClass="button-build"
                        text="Construir"/>

                <Button layoutX="335.0"
                        layoutY="378.0"
                        onAction="#modificarDrone"
                        prefHeight="34.0"
                        prefWidth="130.0"
                        styleClass="button-modify"
                        text="Modificar"/>

                <Button layoutX="655.0"
                        layoutY="378.0"
                        onAction="#eliminarDrone"
                        prefHeight="34.0"
                        prefWidth="130.0"
                        styleClass="button-delete"
                        text="Eliminar"/>

                <Button layoutX="495.0"
                        layoutY="378.0"
                        onAction="#clonarDrone"
                        prefHeight="34.0"
                        prefWidth="130.0"
                        styleClass="button-clone"
                        text="Clonar"/>


                <!-- ===== TABLA ===== -->

                <TableView fx:id="tblDrones"
                           layoutX="15.0"
                           layoutY="430.0"
                           prefHeight="300.0"
                           prefWidth="770.0"
                           styleClass="table-custom">

                    <columns>

                        <!-- ID -->
                        <TableColumn fx:id="colId"
                                     prefWidth="90.0"
                                     text="ID"/>

                        <!-- SERIAL -->
                        <TableColumn fx:id="colSerial"
                                     prefWidth="130.0"
                                     text="Serial"/>

                        <!-- MODELO -->
                        <TableColumn fx:id="colModelo"
                                     prefWidth="140.0"
                                     text="Modelo"/>

                        <!-- FABRICANTE -->
                        <TableColumn fx:id="colFabricante"
                                     prefWidth="150.0"
                                     text="Fabricante"/>

                        <!-- PESO -->
                        <TableColumn fx:id="colPeso"
                                     prefWidth="80.0"
                                     text="Peso"/>

                        <!-- TIPO -->
                        <TableColumn fx:id="colTipo"
                                     prefWidth="170.0"
                                     text="Tipo"/>

                    </columns>

                </TableView>

                <!-- ===== TARJETA: PATRONES BRIDGE Y DECORATOR ===== -->
                <AnchorPane layoutX="15.0"
                            layoutY="745.0"
                            prefHeight="140.0"
                            prefWidth="770.0"
                            styleClass="card-panel">

                    <children>

                        <Label layoutX="20.0"
                               layoutY="12.0"
                               styleClass="section-title"
                               text="Control del drone (Bridge) y batería adicional (Decorator)"/>

                        <!-- BRIDGE: tipo de control -->
                        <Label layoutX="20.0"
                               layoutY="48.0"
                               styleClass="form-label"
                               text="Tipo de control:">
                            <font>
                                <Font size="13.0"/>
                            </font>
                        </Label>

                        <ComboBox fx:id="cbTipoControl"
                                  layoutX="150.0"
                                  layoutY="44.0"
                                  prefHeight="28.0"
                                  prefWidth="160.0"
                                  promptText="Básico / Autónomo"
                                  styleClass="combo-custom"/>

                        <Button layoutX="330.0"
                                layoutY="44.0"
                                onAction="#aplicarControl"
                                prefHeight="30.0"
                                prefWidth="150.0"
                                styleClass="button-build"
                                text="Aplicar control"/>

                        <!-- DECORATOR: batería adicional -->
                        <CheckBox fx:id="chkBateriaAdicional"
                                  layoutX="20.0"
                                  layoutY="92.0"
                                  styleClass="check-custom"
                                  text="Batería adicional"/>

                        <TextField fx:id="txtDescripcionBateria"
                                   layoutX="180.0"
                                   layoutY="86.0"
                                   prefHeight="28.0"
                                   prefWidth="280.0"
                                   promptText="Descripción de la batería adicional"
                                   styleClass="text-field-custom"/>

                        <Button layoutX="480.0"
                                layoutY="86.0"
                                onAction="#verDescripcionDecorator"
                                prefHeight="30.0"
                                prefWidth="160.0"
                                styleClass="button-clone"
                                text="Ver descripción"/>

                    </children>

                </AnchorPane>

                <!-- ===== TARJETA: PATRÓN COMPOSITE (SENSORES) ===== -->
                <AnchorPane layoutX="15.0"
                            layoutY="895.0"
                            prefHeight="55.0"
                            prefWidth="770.0"
                            styleClass="card-panel">

                    <children>

                        <Label layoutX="20.0"
                               layoutY="12.0"
                               styleClass="form-label"
                               text="Gestión de sensores del drone (Composite):">
                            <font>
                                <Font size="13.0"/>
                            </font>
                        </Label>

                        <Button layoutX="500.0"
                                layoutY="8.0"
                                onAction="#abrirVentanaComposite"
                                prefHeight="30.0"
                                prefWidth="180.0"
                                styleClass="button-build"
                                text="Sensores (Composite)"/>
                                
                        <Button layoutX="500.0"
        layoutY="8.0"
        onAction="#mostrarArbolSensoresDemo"
        prefHeight="30.0"
        prefWidth="220.0"
        styleClass="button-build"
        text="Árbol de sensores (demo)"/>

                    </children>

                </AnchorPane>

            </children>

        </AnchorPane>

    </content>

</ScrollPane>
