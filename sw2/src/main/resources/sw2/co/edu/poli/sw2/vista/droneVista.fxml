<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0"
            prefWidth="1280.0"
            styleClass="app-root"
            stylesheets="@droneVista.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.poli.sw2.controller.DroneController">

    <!-- ==================== ENCABEZADO ==================== -->
    <top>
        <VBox spacing="4.0" styleClass="app-header">
            <padding>
                <Insets bottom="20.0" left="32.0" right="32.0" top="20.0"/>
            </padding>
            <children>
                <Label styleClass="app-title" text="Gestión de Drones"/>
                <Label styleClass="app-subtitle"
                       text="Proyecto 2 - Software 2 | Patrones: Factory, Singleton, Prototype, Builder, Bridge, Decorator, Composite y Adapter"/>
            </children>
        </VBox>
    </top>

    <!-- ==================== CONTENIDO ==================== -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="root-scroll">
            <content>

                <VBox spacing="20.0" styleClass="content-box">
                    <padding>
                        <Insets bottom="28.0" left="32.0" right="32.0" top="24.0"/>
                    </padding>

                    <children>

                        <!-- ========== TARJETA: DATOS DEL DRONE ========== -->
                        <VBox spacing="16.0" styleClass="card-panel">
                            <padding>
                                <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
                            </padding>

                            <children>

                                <Label styleClass="card-title" text="Datos del drone"/>

                                <GridPane hgap="18.0" vgap="14.0">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="120.0" prefWidth="130.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="180.0"/>
                                        <ColumnConstraints halignment="RIGHT" minWidth="120.0" prefWidth="130.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="180.0"/>
                                    </columnConstraints>

                                    <children>

                                        <!-- Fila 0 -->
                                        <Label styleClass="form-label" text="ID:"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <TextField fx:id="txtId"
                                                   maxWidth="Infinity"
                                                   promptText="Identificador del drone"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label styleClass="form-label" text="Serial:"
                                               GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                        <TextField fx:id="txtSerial"
                                                   maxWidth="Infinity"
                                                   promptText="Número de serie"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                        <!-- Fila 1 -->
                                        <Label styleClass="form-label" text="Modelo:"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtModelo"
                                                   maxWidth="Infinity"
                                                   promptText="Modelo del drone"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                        <Label styleClass="form-label" text="Fabricante:"
                                               GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtFabricante"
                                                   maxWidth="Infinity"
                                                   promptText="Empresa fabricante"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                        <!-- Fila 2 -->
                                        <Label styleClass="form-label" text="Peso (kg):"
                                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                        <TextField fx:id="txtPeso"
                                                   maxWidth="Infinity"
                                                   promptText="Ej: 12.5"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                        <Label styleClass="form-label" text="Tipo:"
                                               GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                        <ComboBox fx:id="cbTipo"
                                                  maxWidth="Infinity"
                                                  promptText="Seleccione el tipo de drone"
                                                  styleClass="combo-custom"
                                                  GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                                        <!-- Fila 3: separador -->
                                        <Separator GridPane.columnIndex="0"
                                                   GridPane.columnSpan="4"
                                                   GridPane.rowIndex="3"/>

                                        <!-- Fila 4: subtítulo -->
                                        <Label styleClass="section-title"
                                               text="Datos específicos según el tipo"
                                               GridPane.columnIndex="0"
                                               GridPane.columnSpan="4"
                                               GridPane.rowIndex="4"/>

                                        <!-- Fila 5 -->
                                        <Label styleClass="form-label" text="Capacidad tanque:"
                                               GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                        <TextField fx:id="txtCapacidadTanque"
                                                   maxWidth="Infinity"
                                                   promptText="Solo para drones de Agricultura"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                                        <CheckBox fx:id="chkDeteccionTermica"
                                                  styleClass="check-custom"
                                                  text="Detección térmica (solo Vigilancia)"
                                                  GridPane.columnIndex="2"
                                                  GridPane.columnSpan="2"
                                                  GridPane.rowIndex="5"/>

                                    </children>
                                </GridPane>

                                <!-- ========== BOTONES CRUD ========== -->
                                <HBox spacing="14.0">
                                    <children>
                                        <Button maxWidth="Infinity"
                                                onAction="#guardarDrone"
                                                prefHeight="38.0"
                                                styleClass="button-save"
                                                text="Guardar"
                                                HBox.hgrow="ALWAYS"/>
                                        <Button maxWidth="Infinity"
                                                onAction="#construirConBuilder"
                                                prefHeight="38.0"
                                                styleClass="button-build"
                                                text="Construir (Builder)"
                                                HBox.hgrow="ALWAYS"/>
                                        <Button maxWidth="Infinity"
                                                onAction="#modificarDrone"
                                                prefHeight="38.0"
                                                styleClass="button-modify"
                                                text="Modificar"
                                                HBox.hgrow="ALWAYS"/>
                                        <Button maxWidth="Infinity"
                                                onAction="#clonarDrone"
                                                prefHeight="38.0"
                                                styleClass="button-clone"
                                                text="Clonar (Prototype)"
                                                HBox.hgrow="ALWAYS"/>
                                        <Button maxWidth="Infinity"
                                                onAction="#eliminarDrone"
                                                prefHeight="38.0"
                                                styleClass="button-delete"
                                                text="Eliminar"
                                                HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- ========== TARJETA: TABLA ========== -->
                        <VBox spacing="14.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
                            </padding>

                            <children>

                                <Label styleClass="card-title" text="Drones registrados"/>

                                <TableView fx:id="tblDrones"
                                           minHeight="260.0"
                                           prefHeight="340.0"
                                           styleClass="table-custom"
                                           VBox.vgrow="ALWAYS">

                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>

                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="120.0" text="ID"/>
                                        <TableColumn fx:id="colSerial" prefWidth="160.0" text="Serial"/>
                                        <TableColumn fx:id="colModelo" prefWidth="170.0" text="Modelo"/>
                                        <TableColumn fx:id="colFabricante" prefWidth="180.0" text="Fabricante"/>
                                        <TableColumn fx:id="colPeso" prefWidth="110.0" text="Peso (kg)"/>
                                        <TableColumn fx:id="colTipo" prefWidth="160.0" text="Tipo"/>
                                    </columns>

                                    <placeholder>
                                        <Label styleClass="table-placeholder"
                                               text="No hay drones registrados todavía. Complete el formulario y presione Guardar."/>
                                    </placeholder>

                                </TableView>

                            </children>
                        </VBox>

                        <!-- ========== FILA: BRIDGE/DECORATOR + COMPOSITE ========== -->
                        <HBox spacing="20.0">
                            <children>

                                <!-- Bridge y Decorator -->
                                <VBox spacing="14.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
                                    </padding>

                                    <children>

                                        <Label styleClass="card-title"
                                               text="Control del drone (Bridge) y batería adicional (Decorator)"/>

                                        <GridPane hgap="16.0" vgap="14.0">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="RIGHT" minWidth="120.0" prefWidth="135.0"/>
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="160.0"/>
                                                <ColumnConstraints minWidth="170.0" prefWidth="190.0"/>
                                            </columnConstraints>

                                            <children>

                                                <Label styleClass="form-label" text="Tipo de control:"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                                <ComboBox fx:id="cbTipoControl"
                                                          maxWidth="Infinity"
                                                          promptText="Básico / Autónomo"
                                                          styleClass="combo-custom"
                                                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                                <Button maxWidth="Infinity"
                                                        onAction="#aplicarControl"
                                                        prefHeight="34.0"
                                                        styleClass="button-build"
                                                        text="Aplicar control"
                                                        GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                                                <CheckBox fx:id="chkBateriaAdicional"
                                                          styleClass="check-custom"
                                                          text="Batería adicional"
                                                          GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                                <TextField fx:id="txtDescripcionBateria"
                                                           maxWidth="Infinity"
                                                           promptText="Descripción de la batería adicional"
                                                           styleClass="text-field-custom"
                                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <Button maxWidth="Infinity"
                                                        onAction="#verDescripcionDecorator"
                                                        prefHeight="34.0"
                                                        styleClass="button-clone"
                                                        text="Ver descripción"
                                                        GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                                            </children>
                                        </GridPane>

                                    </children>
                                </VBox>

                                <!-- Composite -->
                                <VBox spacing="14.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
                                    </padding>

                                    <children>

                                        <Label styleClass="card-title"
                                               text="Sensores del drone (Composite)"/>

                                        <Label styleClass="help-text"
                                               text="Arme un árbol de sensores en memoria o vea la demostración del diagrama."
                                               wrapText="true"/>

                                        <Button maxWidth="Infinity"
                                                onAction="#abrirVentanaComposite"
                                                prefHeight="34.0"
                                                styleClass="button-build"
                                                text="Gestionar sensores"/>

                                        <Button maxWidth="Infinity"
                                                onAction="#mostrarArbolSensoresDemo"
                                                prefHeight="34.0"
                                                styleClass="button-modify"
                                                text="Árbol de sensores (demo)"/>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <!-- ========== TARJETA: MISIÓN (ADAPTER) ========== -->
                        <VBox spacing="16.0" styleClass="card-panel">
                            <padding>
                                <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
                            </padding>

                            <children>

                                <Label styleClass="card-title"
                                       text="Guardar Misión como JSON (Adapter)"/>

                                <Label styleClass="help-text"
                                       text="La misión se convierte a JSON mediante MisionAdapter y se guarda en disco con ServicioJson."
                                       wrapText="true"/>

                                <GridPane hgap="18.0" vgap="14.0">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="120.0" prefWidth="130.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="180.0"/>
                                        <ColumnConstraints halignment="RIGHT" minWidth="120.0" prefWidth="130.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="180.0"/>
                                    </columnConstraints>

                                    <children>

                                        <Label styleClass="form-label" text="ID Misión:"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <TextField fx:id="txtMisionId"
                                                   maxWidth="Infinity"
                                                   promptText="Identificador de la misión"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label styleClass="form-label" text="Nombre:"
                                               GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                        <TextField fx:id="txtMisionNombre"
                                                   maxWidth="Infinity"
                                                   promptText="Nombre de la misión"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                        <Label styleClass="form-label" text="Ubicación:"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtMisionUbicacion"
                                                   maxWidth="Infinity"
                                                   promptText="Lugar de la misión"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                        <Label styleClass="form-label" text="Fecha:"
                                               GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtMisionFecha"
                                                   maxWidth="Infinity"
                                                   promptText="Ej: 19/10/2025"
                                                   styleClass="text-field-custom"
                                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                        <Label styleClass="form-label" text="Drone:"
                                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                        <ComboBox fx:id="cbDroneParaMision"
                                                  maxWidth="Infinity"
                                                  promptText="Seleccione un drone"
                                                  styleClass="combo-custom"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                        <Button fx:id="btnGuardarMisionJSON"
                                                maxWidth="Infinity"
                                                onAction="#guardarMisionComoJSON"
                                                prefHeight="38.0"
                                                styleClass="button-save"
                                                text="Guardar Misión como JSON"
                                                GridPane.columnIndex="2"
                                                GridPane.columnSpan="2"
                                                GridPane.rowIndex="2"/>

                                    </children>
                                </GridPane>

                            </children>
                        </VBox>

                    </children>
                </VBox>

            </content>
        </ScrollPane>
    </center>

</BorderPane>